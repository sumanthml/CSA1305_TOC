
#include <stdio.h>
#include <string.h>

int main() {
    char str[100];
    int i, flag = 0;

    printf("Enter a string: ");
    scanf("%99s", str);

    for (i = 0; str[i] != '\0'; i++) {
        if (str[i] == '1' && str[i+1] == '0' &&
            str[i+2] == '1') {
            flag = 1;
            break;
        }
    }

    if (flag)
        printf("String is accepted\n");
    else
        printf("String is rejected\n");

    return 0;
}
