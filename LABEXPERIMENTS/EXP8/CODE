
#include <stdio.h>
#include <string.h>

int main() {
    char str[100];
    int len;

    printf("Enter a string: ");
    scanf("%99s", str);

    len = strlen(str);

    if (len >= 2 && str[0] == 'b' && str[len - 1] == 'a')
        printf("String is accepted\n");
    else
        printf("String is rejected\n");

    return 0;
}
